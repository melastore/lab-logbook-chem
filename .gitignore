# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# LibreOffice/OpenOffice lock files
.~lock.*#

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is safe to commit (placeholder values only)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local notes
learn.txt
history.txt

# editor / tooling
.claude/
.antigravitycli/
.gemini/

# private / presentation docs (not for the repo)
/private-docs/
*.docx
*.xlsx
