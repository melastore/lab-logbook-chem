NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Encrypts secrets held in the database (currently two-factor seeds).
# Generate with:  openssl rand -base64 32
# Losing this key means every enrolled user must re-enrol in 2FA. Rotating it
# has the same effect, so treat it like a database credential.
APP_ENCRYPTION_KEY=replace_with_base64_of_32_random_bytes

# Initial password assigned to all generated accounts on first provisioning.
# Must be at least 10 characters. Users are forced to change it on first login,
# and cannot reuse this value as their new password. Keep it private.
LAB_INITIAL_PASSWORD=replace_with_your_own_strong_password
